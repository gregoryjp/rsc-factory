{
	"apiweb": {
		"install": ["npm", "ci"],
		"test": ["npm", "run", "test", "--workspaces", "--if-present"],
		"check": ["npm", "run", "check"],
		"audit": ["npm", "audit", "--omit=dev", "--json"],
		"preview": {
			"install": ["npm", "ci"],
			"build": ["npm", "run", "build", "-w", "web"],
			"staticDir": "web/dist",
			"routesFile": "web/ui-routes.json",
			"authFile": "web/ui-auth.json",
			"api": {
				"build": ["npm", "run", "build", "-w", "api"],
				"migrate": ["npm", "run", "db:deploy", "-w", "api"],
				"start": ["npm", "run", "start", "-w", "api"],
				"port": 3000,
				"healthPath": "/health/ready"
			}
		}
	},
	"api": {
		"install": ["npm", "ci"],
		"test": ["npm", "run", "test", "--workspaces", "--if-present"],
		"check": ["npm", "run", "check"],
		"audit": ["npm", "audit", "--omit=dev", "--json"]
	},
	"landing": {
		"install": ["npm", "ci"],
		"test": ["npm", "test"],
		"check": ["npm", "run", "check"],
		"audit": ["npm", "audit", "--omit=dev", "--json"],
		"preview": {
			"install": ["npm", "ci"],
			"staticDir": ".",
			"routesFile": "ui-routes.json"
		}
	},
	"mobile": {
		"install": ["npm", "ci"],
		"test": ["npm", "test"],
		"check": ["npm", "run", "check"],
		"audit": ["npm", "audit", "--omit=dev", "--json"],
		"preview": {
			"install": ["npm", "ci"],
			"build": ["npm", "run", "build:web"],
			"staticDir": "dist",
			"routesFile": "ui-routes.json"
		}
	}
}
