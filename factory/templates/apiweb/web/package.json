{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": { "node": ">=22" },
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && NODE_ENV=production vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"check": "npm run typecheck && npm run lint && npm test && npm run build"
	},
	"dependencies": {
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/node": "22.20.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"jsdom": "30.1.3",
		"typescript": "5.9.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
