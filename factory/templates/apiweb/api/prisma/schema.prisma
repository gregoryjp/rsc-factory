generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         String    @default("USER")
  createdAt    DateTime  @default(now())
  disabledAt   DateTime?
  sessions     Session[]
}

model Session {
  id               String    @id @default(uuid())
  familyId         String
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenHash  String    @unique
  refreshTokenHash String    @unique
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  rotatedAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
}

model AuditEvent {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  resource  String?
  ip        String?
  requestId String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([createdAt])
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  userId         String
  key            String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([userId, key])
  @@index([expiresAt])
}
