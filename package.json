{
	"name": "gregory-software-factory",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Gregory Software Factory engine",
	"engines": { "node": ">=22" },
	"bin": { "factory": "dist/cli/main.js" },
	"scripts": {
		"factory": "tsx src/cli/main.ts",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run --project unit",
		"test:docker": "vitest run --project docker",
		"check": "npm run typecheck && npm run lint && npm test"
	},
	"dependencies": {
		"better-sqlite3": "13.0.3",
		"commander": "15.0.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "22.20.5",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
